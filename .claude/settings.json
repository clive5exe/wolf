{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(./scripts/verify.sh)",
      "Bash(./scripts/safety_check.sh*)",
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(.venv/bin/python -m ruff*)",
      "Bash(.venv/bin/python -m mypy*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git worktree list)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(security *)",
      "Read(.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/format_changed.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/precommit_guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop_lint.sh"
          }
        ]
      }
    ]
  }
}
